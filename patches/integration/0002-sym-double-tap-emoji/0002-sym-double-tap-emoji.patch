diff --git a/src/input/TLoraPagerKeyboard.cpp b/src/input/TLoraPagerKeyboard.cpp
index 825592f..3546561 100644
--- a/src/input/TLoraPagerKeyboard.cpp
+++ b/src/input/TLoraPagerKeyboard.cpp
@@ -25,6 +25,10 @@
 // multi-tap window, but multi-tap was dead code and this patch removes it, so the
 // name now matches what it actually does. Value unchanged from upstream.
 #define _TCA8418_MODIFIER_TIMEOUT 1500
+// PgrOS: two SYM taps closer together than this open the emoji picker. Long
+// enough to be comfortable, short enough that two deliberate symbol-mode taps
+// (which is a no-op anyway, the second just unlatches) are not mistaken for it.
+#define _TCA8418_SYM_DOUBLE_TAP_MS 450
 
 using Key = TCA8418KeyboardBase::TCA8418Key;
 
@@ -224,6 +228,23 @@ void TLoraPagerKeyboard::pressed(uint8_t key)
     // it, and then type. Tracking the physical hold separately from the sticky
     // latch makes both styles work.
     if (isModifierKey(idx)) {
+        // PgrOS: a second tap of SYM inside the double-tap window asks for the
+        // emoji picker instead of latching symbol mode. SYM is otherwise
+        // swallowed entirely by this driver, so there is no other way for the UI
+        // above to know the key exists.
+        if (idx == modifierSymKey) {
+            if (last_sym_tap && (now - last_sym_tap) < _TCA8418_SYM_DOUBLE_TAP_MS) {
+                last_sym_tap = 0;
+                // The first tap latched symbol mode. Drop it, or dismissing the
+                // picker would leave the keyboard typing punctuation.
+                modifierFlag &= (uint8_t)~modifierSym;
+                modifierHeld &= (uint8_t)~modifierSym;
+                queueEvent(EMOTE_LIST);
+                return;
+            }
+            last_sym_tap = now;
+        }
+
         modifierHeld |= modifierBit(idx);
         updateModifierFlag(idx);
         last_modifier_time = now;
