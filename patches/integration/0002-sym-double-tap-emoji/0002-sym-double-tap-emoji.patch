@@ -27,6 +27,11 @@ class TCA8418KeyboardBase
         MUTE_TOGGLE = 0xAC,
         SEND_PING = 0xAF,
         BL_TOGGLE = 0xAB,
+        // PgrOS: emitted by a double tap of SYM. The value is upstream's own
