     uint8_t next_key;
     uint8_t release_key; // Key index of the release event being processed
     uint32_t last_tap;
+    uint32_t last_sym_tap = 0; // PgrOS: double-tap SYM opens the emoji picker
     uint32_t brightness = 0;
 };
