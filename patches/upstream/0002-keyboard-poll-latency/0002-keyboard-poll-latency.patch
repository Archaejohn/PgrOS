+}
+
+// Poll pacing.
+//
+// A flat 300 ms interval means a keystroke can wait most of a third of a second
+// before the controller is even read, and because the character is emitted on
+// key *release* that delay lands between every letter. It is very noticeable
+// while typing on the boards that have a full keyboard.
+//
+// Typing is bursty, so poll quickly for a short window after each key and fall
+// back to the idle rate when nothing is happening. A user who is not typing
+// still costs one I2C transaction every 300 ms, exactly as before.
+static constexpr int32_t kPollIdleMs = 300;
+static constexpr int32_t kPollActiveMs = 20;
+static constexpr uint32_t kActiveWindowMs = 750;
+
+void KbI2cBase::notifyKey(const InputEvent &e)
+{
+    lastKeyMs = millis();
+    this->notifyObservers(&e);
+}
+
+int32_t KbI2cBase::pollInterval() const
+{
+    if (lastKeyMs && (millis() - lastKeyMs) < kActiveWindowMs)
+        return kPollActiveMs;
+    return kPollIdleMs;
 }
 
